{
  "name": "dsh-whale-balance",
  "version": "0.2.0",
  "private": true,
  "description": "用鲸鱼娘表情包显示 DSH 账号余额，点击人物轮换台词并弹跳回应。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "tools/build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "meta": {
    "title": "鲸鱼娘余额气泡",
    "description": "余额 → 好女孩 → 哦鲸鲸；点击弹跳、自动刷新、拖动和收起。"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
